<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for API 31+.
   admin-passphrase-login: the verified admin passphrase (DataStore file admin_session) is excluded
   from both, so it never leaves the device. Everything else keeps the default behaviour.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/admin_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/admin_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
